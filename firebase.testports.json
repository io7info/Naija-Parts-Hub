{
  "firestore": {
    "rules": "firebase/firestore.rules",
    "indexes": "firebase/firestore.indexes.json"
  },
  "storage": {
    "rules": "firebase/storage.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "nodejs22",
      "ignore": [
        "node_modules",
        ".git",
        "*.log",
        "src/**",
        "**/*.test.ts",
        "tsconfig*.json"
      ],
      "predeploy": [
        "npm --prefix \"$PROJECT_DIR\" run contracts:build",
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ],
  "emulators": {
    "firestore": {
      "host": "127.0.0.1",
      "port": 18080
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  }
}