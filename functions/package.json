{
  "name": "@nph/functions",
  "version": "0.1.0",
  "private": true,
  "description": "Cloud Functions for Naija Parts Hub. Owns every tamper-sensitive state transition.",
  "license": "UNLICENSED",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "serve": "npm run build && firebase emulators:start --only functions,firestore,auth,storage",
    "seed": "node scripts/seed-emulator.mjs",
    "seed:admin": "node scripts/seed-emulator.mjs",
    "admin": "node scripts/admin-review.mjs",
    "seed:marketplace": "node scripts/seed-marketplace.mjs",
    "seed:prod-categories": "node scripts/seed-production-categories.mjs",
    "bootstrap:prod-admin": "node scripts/bootstrap-production-admin.mjs"
  },
  "dependencies": {
    "@nph/contracts": "*",
    "firebase-admin": "^13.0.2",
    "firebase-functions": "^6.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
