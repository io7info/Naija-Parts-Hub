  ],
  "fieldOverrides": [
    {
      "//": "Never range-query the raw Paystack payload; skip indexing it.",
      "collectionGroup": "payments",
      "fieldPath": "raw",
      "indexes": []
    },
    {
      "//": "Long free text is never used as a filter — indexing it wastes writes.",
      "collectionGroup": "listings",
      "fieldPath": "description",
      "indexes": []
    }
  ]
}
