# Copy to .env.local and fill in. .env.local is gitignored and must stay that way.
#
#   cp apps/web/.env.local.example apps/web/.env.local
#
# NEXT_PUBLIC_* values are compiled into browser JavaScript and are readable by
# anyone who opens devtools. That is fine for Firebase web configuration, which
# Google publishes as client configuration — access is enforced by security
# rules and by server-side session verification, not by hiding these strings.
#
# NEVER put any of the following in a NEXT_PUBLIC_* variable:
#   - Firebase service-account JSON     (FIREBASE_SERVICE_ACCOUNT_JSON)
#   - Paystack secret key               (PAYSTACK_SECRET_KEY)
#   - Webhook signing secrets
#   - Any private key or admin credential
# Those are server-only and belong in the Vercel dashboard as plain env vars.

# ---------------------------------------------------------------------------
# Local development against the Firebase Emulator Suite
# ---------------------------------------------------------------------------
# With this set to "true" every value below is ignored: the app runs against
# demo-naija-parts-hub on 127.0.0.1, which needs no credentials and cannot
# reach a real Firebase project. Start the emulators with `npm run emulators`.
#
# Anything other than the exact string "true" means live mode.
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true

# ---------------------------------------------------------------------------
# Live project — Firebase console -> Project settings -> Your apps -> NPH Web
# ---------------------------------------------------------------------------
# Required whenever NEXT_PUBLIC_USE_FIREBASE_EMULATORS is not "true".
# The app refuses to start with a named error if any of these is missing.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=naijapartshub.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=naijapartshub
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=naijapartshub.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=813389632700
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---------------------------------------------------------------------------
# Server-only (never NEXT_PUBLIC_)
# ---------------------------------------------------------------------------
# Required by the Admin SDK in live mode. Single-line JSON of the service
# account key. Leave unset while developing against the emulators.
# FIREBASE_SERVICE_ACCOUNT_JSON=

# Exact origins allowed to POST to /api/admin/session. Comma-separated.
# Defaults to the request origin in development.
# NPH_ALLOWED_ORIGINS=https://naijapartshub.com
