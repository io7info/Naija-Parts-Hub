<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Naija Parts Hub</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Naija Parts Hub</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>

	<!-- App Transport Security.
	     NSAllowsLocalNetworking permits plaintext HTTP to local-network hosts
	     only, which is what the Firebase Local Emulator Suite serves. It is the
	     iOS counterpart to the Android network security config in
	     android/app/src/debug/res/xml/. Deliberately NOT
	     NSAllowsArbitraryLoads, which would disable ATS for every host and is
	     a common App Store review rejection. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>

	<!-- Usage descriptions for image_picker (SOW section 4, listing photos).
	     A MISSING string here is a hard crash on iOS, not a denied permission —
	     the system terminates the app the moment the picker is invoked. The
	     text is shown verbatim in the permission dialog, so it must explain the
	     purpose or App Review rejects it. -->
	<key>NSCameraUsageDescription</key>
	<string>Naija Parts Hub uses the camera so you can photograph parts for your listings.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Naija Parts Hub needs access to your photos so you can add existing images to your listings.</string>

	<!-- Firebase phone auth callback scheme. REQUIRED, including against the
	     Local Emulator Suite.

	     This key must exist before any call to verifyPhoneNumber, and its
	     absence is not a graceful degradation — it is an immediate crash.
	     FirebaseAuth reads it into an implicitly-unwrapped optional
	     (Auth.swift: `var mainBundleUrlTypes: [[String: Any]]!`) and
	     dereferences it on the first line of the function
	     (PhoneAuthProvider.swift:108-109), so a missing key force-unwraps nil
	     and takes the process down with EXC_BREAKPOINT. FirebaseAuth does have
	     a readable error for an unregistered scheme — "Please register custom
	     URL scheme ... in the app's Info.plist file" — but it can never print,
	     because the nil unwrap is on the same statement. Present-but-wrong is
	     diagnosable; absent is a bare trap.

	     None of this is bypassed by useAuthEmulator: the check runs before any
	     emulator branching.

	     The scheme value is derived by PhoneAuthProvider.init. With no
	     `clientID` in FirebaseOptions — the emulator case, see
	     lib/core/firebase_bootstrap.dart — it falls back to the app id with
	     ':' replaced by '-', prefixed "app-". That is what the entry below is,
	     matching Env.demoAppId for iOS.

	     After `flutterfire configure` the real options carry a clientID, and
	     init prefers the REVERSED_CLIENT_ID scheme *if it is registered here*,
	     falling back to this one otherwise. Add it as a second string in the
	     same array rather than replacing this one, so emulator and live builds
	     both work from one Info.plist. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>firebase-auth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<!-- Emulator / no-clientID fallback. Mirrors Env.demoAppId (iOS). -->
				<string>app-1-000000000000-ios-0000000000000000</string>
				<!-- TODO(ios): add REVERSED_CLIENT_ID from GoogleService-Info.plist
				     once `flutterfire configure` has run, for live builds. -->
			</array>
		</dict>
	</array>

	<!-- TODO(ios): phone OTP on a REAL DEVICE against a live project also needs
	     an APNs .p8 auth key uploaded to Firebase and the Push Notifications
	     capability (paid Apple Developer account only — the long pole on the
	     iOS track). Not required on the simulator against the emulator suite,
	     where the Auth emulator issues codes over REST. -->

	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
