<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Allows cleartext HTTP to the Firebase emulator hosts only.
         See res/xml/network_security_config.xml.

         This file is src/debug, so the attribute is merged into debug builds
         only — release builds keep Android's secure-by-default posture and no
         cleartext exception ever ships to the Play Store. -->
    <application
        android:networkSecurityConfig="@xml/network_security_config" />
</manifest>
